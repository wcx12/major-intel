{
  "metadata": {
    "version": 1,
    "purpose": "Boundary and final-answer safety cases for school_major_profile."
  },
  "cases": [
    {
      "id": "hdu_cs_no_context_ok",
      "question": "杭电计算机怎么样？",
      "tool_args": {
        "school_text": "杭州电子科技大学",
        "major_text": "计算机科学与技术"
      },
      "expected_tool": {
        "status": "ok",
        "evidence_summary": {
          "has_department_catalog": true,
          "has_admission_or_plan": true
        }
      },
      "expected_answer": {
        "must_include_any": [
          ["学校级", "不能代表某专业", "专业级"]
        ],
        "must_not_include": ["专业录取线是", "专业就业率很高"]
      }
    },
    {
      "id": "hdu_cs_zj_physics_2025_partial",
      "question": "浙江物理2025年，杭电计算机怎么样？",
      "tool_args": {
        "school_text": "杭州电子科技大学",
        "major_text": "计算机科学与技术",
        "province": "浙江",
        "subject_type": "物理",
        "year": 2025
      },
      "expected_tool": {
        "status": "partial",
        "evidence_summary": {
          "has_department_catalog": true,
          "has_admission_or_plan": false
        },
        "must_have_evidence_gaps": ["招生/录取证据"],
        "must_have_warning_contains": ["未命中该省份/科类/年份招生或录取证据"]
      },
      "expected_answer": {
        "must_include": ["浙江", "物理"],
        "must_include_any": [
          ["未命中", "缺少", "不能直接", "需核实"]
        ],
        "must_not_include": ["浙江物理2025专业录取线", "可以直接参考录取线"]
      }
    },
