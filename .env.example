# Copy this file to .env and fill in your real DeepSeek key.
# .env is ignored by git.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Local MySQL used by retrieval tools.
# These names are read by scripts/local_retrieval_mvp.py::DbConfig.from_env().
GAOKAO_DB_HOST=127.0.0.1
GAOKAO_DB_PORT=3306
GAOKAO_DB_USER=root
GAOKAO_DB_PASSWORD=your_mysql_password_here
GAOKAO_DB_NAME=gaokao_test_local
