# Copy this file to .env and fill in your real DeepSeek key.
# .env is ignored by git.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Local MySQL used by retrieval tools.
# These names are read by scripts/local_retrieval_mvp.py::DbConfig.from_env().
GAOKAO_DB_HOST=127.0.0.1
GAOKAO_DB_PORT=3306
GAOKAO_DB_USER=root
GAOKAO_DB_PASSWORD=your_mysql_password_here
GAOKAO_DB_NAME=gaokao_test_local

# Remote MySQL used only when explicitly comparing or syncing with remote.
# Do not reuse GAOKAO_DB_* for remote unless you intentionally want all retrieval
# tools to point at remote instead of local.
GAOKAO_REMOTE_DB_HOST=your_remote_mysql_host_here
GAOKAO_REMOTE_DB_PORT=3306
GAOKAO_REMOTE_DB_USER=your_remote_mysql_user_here
GAOKAO_REMOTE_DB_PASSWORD=your_remote_mysql_password_here
GAOKAO_REMOTE_DB_NAME=gaokao_test

# Optional remote MySQL SSL settings. Leave blank unless your cloud database
# requires a CA certificate or a stricter SSL mode.
GAOKAO_REMOTE_DB_SSL_CA=
GAOKAO_REMOTE_DB_SSL_MODE=PREFERRED

# Optional connection behavior.
GAOKAO_REMOTE_DB_CHARSET=utf8mb4
GAOKAO_REMOTE_DB_CONNECT_TIMEOUT=10
